{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.1.3",
  "identifier": "com.orbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "10.15" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRjlDMEQwNTI3REYxRTIKUldUaThYMVMwTUQ1UWUrTFg5Q2NuQ0FhcElhUXFPZE9yTGFQRzVXVnZ0aDZicFBDa1lIUkk2MEIK",
      "endpoints": [
        "https://github.com/caicdo/orbit/releases/latest/download/latest.json"
      ]
    }
  }
}
